    "Die Datendatei konnte nicht gelesen werden und wurde unter %@ gesichert. ChemJournal startet mit einem leeren Journal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data file could not be read and was saved as %@. ChemJournal starts with an empty journal."
          }
