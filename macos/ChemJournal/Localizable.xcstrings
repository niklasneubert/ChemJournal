    "ChemJournal sichert automatisch: beim ersten Speichern, danach höchstens alle 10 Minuten, wenn sich etwas geändert hat, und beim Beenden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChemJournal saves versions automatically: on the first save, then at most every 10 minutes when something has changed, and when quitting."
          }
        }
      }
