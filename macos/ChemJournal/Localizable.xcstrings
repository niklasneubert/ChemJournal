          }
        }
      }
    },
    "ReShiki ist kostenlos und quelloffen (reshiki.com). Nach der Installation hier einfach erneut klicken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReShiki is free and open source (reshiki.com). After installing it, just click here again."
          }
        }
      }
    },
    "Installiere ChemDraw oder wähle in den Einstellungen ReShiki als Zeichenprogramm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install ChemDraw or choose ReShiki as the drawing program in Settings."
